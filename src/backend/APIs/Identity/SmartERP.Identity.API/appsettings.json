{
  "ConnectionStrings": {
    "IdentityDatabase": "Server=localhost;Database=SmartERPIdentityDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SenderName": "SmartERP",
    "UseStartTls": true
  },
  "Jwt": {
    "Issuer": "SmartERP.Identity",
    "Audience": "SmartERP.Services",
    "AccessTokenExpirationMinutes": 15
  },
  "RefreshToken": {
    "ExpirationDays": 30,
    "TokenSizeInBytes": 64,
    "MaxActiveSessionsPerUser": 5,
    "CookieName": "SmartERP.RefreshToken"
  },
  "AuthorizationSeed": {
    "SuperAdminEmail": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },

  "RateLimiting": {
    "AuthenticationPermitLimit": 5,
    "AuthenticationWindowSeconds": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*"
}
