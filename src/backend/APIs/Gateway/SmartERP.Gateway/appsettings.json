{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 5,
    "AuthenticationWindowSeconds": 60,
    "GatewayPermitLimit": 100,
    "GatewayWindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "SmartERP.Identity",
    "Audience": "SmartERP.Services"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-register-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/register"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-confirm-email-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/confirm-email"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-resend-confirmation-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/resend-confirmation-email"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-login-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/login"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-forgot-password-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/forgot-password"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-reset-password-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/reset-password"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-google-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/google"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-google-callback-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/google/callback"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-refresh-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "authentication",
        "Match": {
          "Path": "/api/identity/api/auth/refresh"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-service-info-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/identity/"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-health-public": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "Disable",
        "Match": {
          "Path": "/api/identity/health/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity-protected": {
        "ClusterId": "identity-cluster",
        "Order": 100,
        "AuthorizationPolicy": "Default",
        "RateLimiterPolicy": "gateway",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "https://localhost:7054/"
          }
        }
      }
    }
  }
}
