{
  "ConnectionStrings": {
    "InventoryDatabase": "Server=localhost;Database=SmartERPInventoryDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "SmartERP.Identity",
    "Audience": "SmartERP.Services"
  },
  "Services": {
    "OrganizationBaseUrl": "http://localhost:5133/"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "RateLimiting": {
    "AuthenticationPermitLimit": 5,
    "AuthenticationWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
