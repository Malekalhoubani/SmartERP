{
  "ConnectionStrings": {
    "OrganizationDatabase": "Server=localhost;Database=SmartERPOrganizationDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Jwt": {
    "Issuer": "SmartERP.Identity",
    "Audience": "SmartERP.Services"
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },

  "RateLimiting": {
    "AuthenticationPermitLimit": 5,
    "AuthenticationWindowSeconds": 60,
    "GatewayPermitLimit": 100,
    "GatewayWindowSeconds": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*"
}